{
  "$schema": "https://json.schemastore.org/package",
  "name": "@crystaltides/launcher-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "tsc && vite build",
    "build:analyze": "vite build --mode analyze",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "lint": "oxlint --no-ignore src",
    "lint:fast": "oxlint --no-ignore src",
    "doctor": "react-doctor",
    "doctor:score": "react-doctor --score",
    "doctor:staged": "react-doctor --staged --blocking warning",
    "doctor:changed": "react-doctor --verbose --scope changed",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@supabase/phoenix": "^0.4.5",
    "@supabase/supabase-js": "^2.89.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tauri-apps/plugin-positioner": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.2.0",
    "lucide": "^1.31.0",
    "lucide-react": "^1.31.0",
    "morphicons": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
