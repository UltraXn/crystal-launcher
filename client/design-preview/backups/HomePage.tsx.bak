import React, { useState, useEffect } from "react";
import { CrystalCard } from "./CrystalCard";
import { CrystalButton } from "./CrystalButton";
import { useAuth } from "../services/authContext";
import { fetchServerStatus, type ServerStatus } from "../services/serverStatusService";
import { syncOfficialMods } from "../services/modService";
import { launchGame } from "../services/launcherService";
import { getSettings } from "../services/settingsService";
import {
  Profile,
  getActiveProfile,
  resolveProfileGameDir,
} from "../services/profileService";
import { ProfileSelector } from "./ProfileSelector";
import { ProfileEditorDialog } from "./ProfileEditorDialog";
import { SkinViewer } from "./SkinViewer";
import { invoke } from "@tauri-apps/api/core";

export const HomePage: React.FC = () => {
  const { currentSession } = useAuth();
  const [serverStatus, setServerStatus] = useState<ServerStatus | null>(null);
  const [isLoadingStatus, setIsLoadingStatus] = useState(true);
  const [isLaunching, setIsLaunching] = useState(false);
  const [launchStatus, setLaunchStatus] = useState<string | null>(null);
  const [launchProgress, setLaunchProgress] = useState(0);
  const [launchError, setLaunchError] = useState<string | null>(null);

  // Profile Dialog states
  const [activeProfile, setActiveProfile] = useState<Profile>(getActiveProfile());
  const [isEditingProfile, setIsEditingProfile] = useState(false);
  const [isCreatingProfile, setIsCreatingProfile] = useState(false);
  const [profileToEdit, setProfileToEdit] = useState<Profile | null>(null);

  useEffect(() => {
    loadServerStatus();
  }, []);

  const loadServerStatus = async () => {
    setIsLoadingStatus(true);
    const status = await fetchServerStatus("mc.crystaltidesSMP.net");
    setServerStatus(status);
    setIsLoadingStatus(false);
  };

  const handleProfileChanged = () => {
    setActiveProfile(getActiveProfile());
  };

  const handlePlay = async () => {
    if (!currentSession || isLaunching) return;
    setIsLaunching(true);
    setLaunchError(null);
    setLaunchStatus("Resolviendo directorios...");
    setLaunchProgress(0.02);

    try {
      const homeDir: string | null = await invoke("get_home_dir");
      if (!homeDir) throw new Error("No se pudo obtener el directorio personal.");

      const profile = getActiveProfile();
      const resolvedGameDir = resolveProfileGameDir(profile, homeDir);
      const settings = getSettings();

      // Only sync mods if it's not a pure vanilla profile
      if (profile.loaderType !== "vanilla" && profile.loaderType !== "") {
        setLaunchStatus("Sincronizando mods...");
        setLaunchProgress(0.05);
        await syncOfficialMods(resolvedGameDir, (status, progress) => {
          setLaunchStatus(status);
          setLaunchProgress(progress * 0.4); // Scale to 40% of the bar
        });
      }

      setLaunchStatus("Iniciando Minecraft...");
      setLaunchProgress(0.5);

      await launchGame({
        username: currentSession.username,
        uuid: currentSession.uuid || "00000000-0000-0000-0000-000000000000",
        accessToken: currentSession.accessToken || "placeholder_token",
        mcVersion: profile.mcVersion,
        loaderType: profile.loaderType,
        loaderVersion: profile.loaderVersion,
        minRam: profile.minRam !== undefined ? profile.minRam : settings.minRam,
        maxRam: profile.maxRam !== undefined ? profile.maxRam : settings.maxRam,
        useOptimization: profile.useOptimization,
        javaArgs: profile.javaArgs,
        javaPath: profile.javaPath || settings.javaPath || undefined,
        gameDir: resolvedGameDir,
      }, (status, progress) => {
        setLaunchStatus(status);
        setLaunchProgress(0.5 + progress * 0.5);
      });

      setTimeout(() => {
        setLaunchStatus(null);
        setIsLaunching(false);
      }, 5000);
    } catch (err: any) {
      setLaunchError(err.message || String(err));
      setLaunchStatus(null);
      setIsLaunching(false);
    }
  };

  const statusDotColor = (): string => {
    if (isLoadingStatus) return "#FFA726";
    if (!serverStatus) return "rgba(255,255,255,0.3)";
    return serverStatus.online ? "#10B981" : "#EF4444";
  };

  const statusLabel = (): string => {
    if (isLoadingStatus) return "Consultando...";
    if (!serverStatus) return "No disponible";
    if (!serverStatus.online) return "Desconectado";
    if (serverStatus.playersOnline !== null && serverStatus.playersMax !== null) {
      return `${serverStatus.playersOnline}/${serverStatus.playersMax} jugadores`;
    }
    return "En línea";
  };

  const statusDescription = (): string => {
    if (isLoadingStatus) return "Conectando con el servidor de CrystalTides...";
    if (!serverStatus) return "No se pudo obtener el estado del servidor.";
    if (!serverStatus.online) return "El servidor está actualmente desconectado.";
    if (serverStatus.playersOnline !== null && serverStatus.playersMax !== null) {
      return `El servidor está en línea con ${serverStatus.playersOnline} de ${serverStatus.playersMax} jugadores conectados.`;
    }
    return "El servidor de CrystalTides está en línea y esperándote.";
  };

  const authTypeLabel = (): string => {
    switch (currentSession?.type) {
      case "guest": return "Cuenta Invitado";
      case "crystal": return "Cuenta CrystalTides";
      case "microsoft": return "Cuenta Premium";
      default: return "Sin sesión";
    }
  };

  return (
    <div style={{
      padding: 32,
      display: "flex",
      flexDirection: "column",
      height: "100%",
      boxSizing: "border-box",
      justifyContent: "space-between",
    }}>
      {/* Top: User Info + Server Badge */}
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", marginBottom: 20 }}>
        <div>
          <h2 style={{ margin: 0, fontSize: 16, fontWeight: "bold", color: "#FFFFFF", letterSpacing: 1, textTransform: "uppercase" }}>
            {currentSession?.username || "Invitado"}
          </h2>
          <p style={{ margin: "2px 0 0 0", fontSize: 12, color: "var(--text-muted)" }}>
            {authTypeLabel()} • Perfil: {activeProfile.name} ({activeProfile.mcVersion})
          </p>
        </div>
        <div style={{
          display: "flex",
          alignItems: "center",
          gap: 8,
          padding: "8px 16px",
          borderRadius: 24,
          backgroundColor: "var(--surface-ultra-low)",
          border: "1px solid var(--border-low)",
        }}>
          <div style={{
            width: 8,
            height: 8,
            borderRadius: "50%",
            backgroundColor: statusDotColor(),
            boxShadow: `0 0 8px ${statusDotColor()}`,
          }} />
          <span style={{ fontSize: 12, color: "rgba(255,255,255,0.8)", fontWeight: 500 }}>{statusLabel()}</span>
        </div>
      </div>

      {/* Middle Split: Content, Skin Viewer */}
      <div style={{ display: "flex", flex: 1, gap: 24, minHeight: 0, marginBottom: 24 }}>
        {/* Left Side: Server Card and News */}
        <div style={{ flex: 2, display: "flex", flexDirection: "column", gap: 20, minHeight: 0 }}>
          {/* Server Status Card */}
          <CrystalCard style={{ padding: 24 }} enableHoverEffect={false}>
            <div style={{ display: "flex", alignItems: "center", gap: 8, marginBottom: 12 }}>
              <span style={{ fontSize: 16 }}>🖥️</span>
              <span style={{
                color: "var(--accent)",
                fontWeight: "bold",
                letterSpacing: 2,
                fontSize: 12,
                textTransform: "uppercase",
              }}>
                Estado del Servidor
              </span>
            </div>
            <p style={{ margin: 0, color: "rgba(255,255,255,0.7)", fontSize: 14, lineHeight: 1.5 }}>
              {statusDescription()}
            </p>
          </CrystalCard>

          {/* Server Announcement / News Card */}
          <CrystalCard style={{ padding: 24, textAlign: "left", flex: 1, display: "flex", flexDirection: "column", justifyContent: "center" }} enableHoverEffect={false}>
            <h4 style={{ margin: "0 0 10px 0", fontSize: 15, fontWeight: "bold", color: "#FFFFFF", display: "flex", alignItems: "center", gap: 8 }}>
              📢 Notas de Parche • v2.0.0 (Tauri Core)
            </h4>
            <div style={{ display: "flex", flexDirection: "column", gap: 8, fontSize: 13, color: "var(--text-muted)", lineHeight: 1.5 }}>
              <div>• <b>Migración Tauri Core</b>: Launcher reescrito en Rust para reducir un 90% el uso de memoria RAM e iniciar al instante.</div>
              <div>• <b>Selector Dinámico</b>: Integración con Mojang, Fabric y NeoForge para listar todas las versiones en vivo.</div>
              <div>• <b>Skin 3D Aclarada</b>: Mejorada la iluminación del modelo de personaje dentro del visor 3D.</div>
              <div>• <b>Estética Vectorial</b>: Iconos emojis reemplazados por SVG modernos con micro-animaciones en hover/active.</div>
            </div>
            <div style={{ display: "flex", gap: 16, marginTop: 16 }}>
              <span style={{ fontSize: 11, color: "var(--accent)", fontWeight: 500 }}>🌐 IP: mc.crystaltidesSMP.net</span>
              <span style={{ fontSize: 11, color: "rgba(255,255,255,0.1)" }}>|</span>
              <span style={{ fontSize: 11, color: "var(--accent)", fontWeight: 500 }}>💬 discord.gg/crystaltides</span>
            </div>
          </CrystalCard>
        </div>

        {/* Right Side: Character Showcase */}
        <div style={{ flex: 1.2, display: "flex", flexDirection: "column", minHeight: 0 }}>
          <CrystalCard style={{
            flex: 1,
            display: "flex",
            flexDirection: "column",
            padding: 16,
            minHeight: 0,
            overflow: "hidden",
            alignItems: "center",
            justifyContent: "center",
            position: "relative"
          }} enableHoverEffect={false}>
            {/* Background cyan/teal glow behind the 3D skin */}
            <div style={{
              position: "absolute",
              width: 140,
              height: 140,
              borderRadius: "50%",
              backgroundColor: "rgba(45, 212, 191, 0.15)",
              filter: "blur(40px)",
              zIndex: 0,
            }} />
            <div style={{ width: "100%", height: "100%", zIndex: 1 }}>
              <SkinViewer username={currentSession?.username || "Steve"} uuid={currentSession?.uuid} />
            </div>
          </CrystalCard>
        </div>
      </div>

      {/* Bottom: Progress + Controls */}
      <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
        {/* Launch Progress */}
        {launchStatus && (
          <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
            <div style={{ display: "flex", justifyContent: "space-between", fontSize: 13, color: "var(--accent)" }}>
              <span>{launchStatus}</span>
              <span>{Math.round(launchProgress * 100)}%</span>
            </div>
            <div style={{ width: "100%", height: 6, borderRadius: 3, backgroundColor: "rgba(255,255,255,0.06)", overflow: "hidden" }}>
              <div style={{
                width: `${launchProgress * 100}%`,
                height: "100%",
                backgroundColor: "var(--accent)",
                boxShadow: "0 0 12px var(--accent)",
                transition: "width 200ms ease",
              }} />
            </div>
          </div>
        )}

        {launchError && (
          <div style={{
            backgroundColor: "rgba(239, 68, 68, 0.1)",
            border: "1px solid var(--danger)",
            borderRadius: 10,
            padding: "10px 14px",
            color: "#FFBABA",
            fontSize: 13,
            textAlign: "left",
          }}>
            ⚠️ {launchError}
          </div>
        )}

        <div style={{ display: "flex", alignItems: "center", gap: 16 }}>
          {/* Profile Selector */}
          <ProfileSelector
            onEditProfile={(p) => {
              setProfileToEdit(p);
              setIsEditingProfile(true);
            }}
            onCreateProfile={() => {
              setIsCreatingProfile(true);
            }}
            onProfileChanged={handleProfileChanged}
          />

          {/* Play Button */}
          <CrystalButton
            text={isLaunching ? "Iniciando..." : "¡JUGAR!"}
            variant="primary"
            size="lg"
            isLoading={isLaunching}
            onPressed={handlePlay}
            style={{
              fontSize: 18,
              letterSpacing: 2,
              fontWeight: "bold",
              padding: "16px 0",
              flex: 1,
            }}
          />
        </div>
      </div>

      {/* Editor/Creator Modal */}
      {(isEditingProfile || isCreatingProfile) && (
        <ProfileEditorDialog
          profile={isEditingProfile ? profileToEdit : null}
          onClose={() => {
            setIsEditingProfile(false);
            setIsCreatingProfile(false);
            setProfileToEdit(null);
          }}
          onSave={handleProfileChanged}
        />
      )}
    </div>
  );
};
