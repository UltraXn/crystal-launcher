{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrystalTides Launcher Installer",
  "version": "0.1.0",
  "identifier": "net.crystaltides.launcher.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14210",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrystalTides Launcher Installer",
        "width": 640,
        "height": 650,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
